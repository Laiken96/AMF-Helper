{
  "name": "nfl-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "job:schedule": "tsx jobs/fetch-schedule.ts",
    "job:tips": "tsx jobs/build-tips.ts",
    "job:watch": "tsx jobs/watch.ts",
    "job:push": "tsx jobs/push.ts",
    "job:review": "tsx jobs/build-review.ts",
    "job:standings": "tsx jobs/standings.ts",
    "job:news": "tsx jobs/news.ts",
    "job:index": "tsx jobs/weeks-index.ts",
    "job:opinion": "tsx jobs/opinion.ts",
    "job:heartbeat": "tsx jobs/heartbeat.ts",
    "job:picks": "tsx jobs/picks.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-push": "^3.6.7"
  }
}
